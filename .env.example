# Release Manager — environment configuration (names and placeholders only).
# Copy to your Vercel project settings; never commit real secret values.

# --- Persistence -----------------------------------------------------------
# Managed Postgres DSN. Set EITHER of these to select Postgres; leave both
# empty for the SQLite fallback (local dev / CI only).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
POSTGRES_URL=

# --- Origins --------------------------------------------------------------
# Public web origin; drives <production-domain> and the Secure cookie flag.
RELEASE_MANAGER_WEB_URL=https://your-app.example.com
# Server-only internal base the Next.js route handlers use to reach FastAPI.
RELEASE_MANAGER_API_URL=https://your-app.example.com/_api

# --- GitHub OAuth App ----------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
# Must end with /auth/github/callback and live on the web origin.
GITHUB_OAUTH_CALLBACK_URL=https://your-app.example.com/auth/github/callback

# --- Sessions & Cron ---------------------------------------------------
# HMAC key for the opaque session cookie.
SESSION_SECRET=generate-a-long-random-string
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-string
# Vercel Cron automatically sends User-Agent: vercel-cron/1.0. The public
# route validates that plus CRON_SECRET, then adds its fixed internal proof
# header itself. Do not configure VERCEL_* variables; Vercel reserves them.

# --- Standalone dev only (ignored by the serverless entrypoint) --------
SCHEDULER_INTERVAL_SECONDS=30
RELEASE_MANAGER_DB=release-manager.db
